{
  "version": "3.0",
  "id": "SimConnectInput",
  "display_name": "SimConnect Input",
  "scheduler_role": "Source",
  "interface": [
    {
      "name": "out",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": true
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Reads an MSFS 2024 simulation variable via SimConnect and outputs it as a signal. Supports all MSFS 2024 Vars API categories: AVar, LVar, HEvent, BVar, EVar, IVar, OVar, ZVar. In JIT/Editor mode the SimConnectProvider injects values before each simulation step. In WASM/AOT mode uses direct Vars API.",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "var_name": "",
    "var_type": "AVar",
    "unit": "number",
    "index": "0",
    "default_value": "0.0",
    "val_type": "Float32",
    "tier": "1",
    "epsilon": "0.01"
  },
  "param_schema": {
    "var_name": {
      "type": "string"
    },
    "var_type": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "index": {
      "type": "int"
    },
    "default_value": {
      "type": "float"
    },
    "val_type": {
      "type": "string"
    },
    "tier": {
      "type": "int"
    },
    "epsilon": {
      "type": "float"
    }
  }
}
