{
  "version": "3.0",
  "id": "SimConnectOutput",
  "display_name": "SimConnect Output",
  "scheduler_role": "Consumer",
  "interface": [
    {
      "name": "in",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Writes a signal value to an MSFS 2024 simulation variable via SimConnect. Supports all MSFS 2024 Vars API categories: AVar, LVar, HEvent, BVar, EVar, IVar, OVar, ZVar. In data mode uses fsVars*Set. In event mode triggers via fsEventsHEventCall. In JIT/Editor mode the SimConnectProvider extracts values after each simulation step.",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "var_name": "",
    "var_type": "AVar",
    "unit": "number",
    "index": "0",
    "mode": "data",
    "event_name": "",
    "event_id": "0",
    "val_type": "Float32"
  },
  "param_schema": {
    "var_name": {
      "type": "string"
    },
    "var_type": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "index": {
      "type": "int"
    },
    "mode": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "event_id": {
      "type": "int"
    },
    "val_type": {
      "type": "string"
    }
  }
}
