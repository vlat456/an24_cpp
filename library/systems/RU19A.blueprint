      "domain": 1,
      "direction": 1,
      "type": "V"
    },
    {
      "name": "v_start",
      "domain": 1,
      "direction": 0,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
