{
  "version": "3.0",
  "id": "lamp_pass_through",
  "display_name": "lamp_pass_through",
  "interface": [
    {
      "name": "vin",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "vout",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [
    {
      "id": "lamp",
      "type": "IndicatorLight",
      "params": {
        "max_brightness": 100.0
      }
    },
    {
      "id": "vin",
      "type": "BlueprintInput"
    },
    {
      "id": "vout",
      "type": "BlueprintOutput"
    }
  ],
  "wires": [
    {
      "id": "w0",
      "source": "/vin:port",
      "target": "/lamp:v_in"
    },
    {
      "id": "w1",
      "source": "/lamp:v_out",
      "target": "/vout:port"
    }
  ],
  "nested": [],
  "cpp_class": false,
  "description": "Voltage pass-through with indicator lamp for debug",
  "domains": [
    "Electrical"
  ],
  "priority": "high",
  "critical": true
}
