{
  "version": "3.0",
  "id": "lamp_pass_through",
  "display_name": "lamp_pass_through",
  "scheduler_source": false,
  "interface": [
    {
      "name": "vin",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "vout",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": false
    }
  ],
  "nodes": [
    {
      "id": "lamp",
      "type": "IndicatorLight",
      "params": {
        "max_brightness": 100.0
      },
      "ports": {
        "brightness": {
          "direction": "Out",
          "type": "I"
        },
        "v_in": {
          "direction": "In",
          "type": "V"
        },
        "v_out": {
          "direction": "Out",
          "type": "V"
        }
      }
    },
    {
      "id": "vin",
      "type": "BlueprintInput",
      "ports": {
        "ext": {
          "direction": "In",
          "type": "Any"
        },
        "port": {
          "direction": "Out",
          "type": "Any"
        }
      }
    },
    {
      "id": "vout",
      "type": "BlueprintOutput",
      "ports": {
        "ext": {
          "direction": "Out",
          "type": "Any"
        },
        "port": {
          "direction": "In",
          "type": "Any"
        }
      }
    }
  ],
  "wires": [
    {
      "id": "w0",
      "source": "/vin:port",
      "target": "/lamp:v_in"
    },
    {
      "id": "w1",
      "source": "/lamp:v_out",
      "target": "/vout:port"
    }
  ],
  "nested": [],
  "cpp_class": false,
  "description": "Voltage pass-through with indicator lamp for debug",
  "domains": [
    "Electrical"
  ],
  "priority": "high",
  "critical": true
}
