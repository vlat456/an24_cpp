{
  "version": "3.0",
  "id": "simple_battery",
  "display_name": "simple_battery",
  "interface": [
    {
      "name": "vin",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "vout",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [
    {
      "id": "bat",
      "type": "Battery",
      "params": {
        "internal_r": 0.01,
        "v_nominal": 28.0
      },
      "ports": {
        "v_in": {
          "direction": "In",
          "type": "V"
        },
        "v_out": {
          "direction": "Out",
          "type": "V"
        }
      }
    },
    {
      "id": "gnd",
      "type": "RefNode",
      "params": {
        "value": 0.0
      },
      "ports": {
        "v": {
          "direction": "Out",
          "type": "V"
        }
      }
    },
    {
      "id": "vin",
      "type": "BlueprintInput",
      "ports": {
        "ext": {
          "direction": "In",
          "type": "Any"
        },
        "port": {
          "direction": "Out",
          "type": "Any"
        }
      }
    },
    {
      "id": "vout",
      "type": "BlueprintOutput",
      "ports": {
        "ext": {
          "direction": "Out",
          "type": "Any"
        },
        "port": {
          "direction": "In",
          "type": "Any"
        }
      }
    }
  ],
  "wires": [
    {
      "id": "w0",
      "source": "/vin:port",
      "target": "/bat:v_in"
    },
    {
      "id": "w1",
      "source": "/bat:v_out",
      "target": "/vout:port"
    },
    {
      "id": "w2",
      "source": "/gnd:v",
      "target": "/vin:port"
    }
  ],
  "nested": [],
  "cpp_class": false,
  "description": "Simple battery module with exposed input/output ports",
  "domains": [
    "Electrical"
  ],
  "priority": "high",
  "critical": true
}
