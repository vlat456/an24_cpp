{
  "version": "3.0",
  "id": "ControlledCurrentSource",
  "display_name": "ControlledCurrentSource",
  "scheduler_role": "Consumer",
  "interface": [
    {
      "name": "v_pos",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": true
    },
    {
      "name": "v_neg",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "cmd",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Control-to-electrical domain bridge (current source). Converts a control/scalar command into a Norton current source stamped during solve_electrical(). i_source = cmd * gain, clamped to [min_i, max_i]. g_shunt is a small parallel conductance to keep the node well-conditioned.",
  "domains": [
    "Electrical"
  ],
  "param_defaults": {
    "gain": "1.0",
    "min_i": "0.0",
    "max_i": "100.0",
    "g_shunt": "0.001"
  },
  "param_schema": {
    "gain": {"type": "float"},
    "min_i": {"type": "float"},
    "max_i": {"type": "float"},
    "g_shunt": {"type": "float"}
  }
}
