{
  "version": "3.0",
  "id": "12SAM28",
  "display_name": "12-SAM-28 Battery",
  "scheduler_source": false,
  "interface": [
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "charge_out",
      "domain": 1,
      "direction": 1,
      "type": "Any",
      "source_writer": false
    },
    {
      "name": "soc_out",
      "domain": 1,
      "direction": 1,
      "type": "Any",
      "source_writer": false
    }
  ],
  "nodes": [
    {
      "id": "src",
      "type": "ElectricalSource",
      "params": {
        "voltage": 25.2,
        "resistance": 0.05
      },
      "ports": {
        "v_in": { "direction": "In",  "type": "V" },
        "v_out": { "direction": "Out", "type": "V" }
      }
    },
    {
      "id": "csense",
      "type": "CurrentSense",
      "params": {
        "conductance": 1000.0
      },
      "ports": {
        "v_in":  { "direction": "In",  "type": "V" },
        "v_out": { "direction": "Out", "type": "V" },
        "i_out": { "direction": "Out", "type": "I" }
      }
    },
    {
      "id": "zero",
      "type": "Value",
      "params": {
        "value": 0.0
      },
      "ports": {
        "o": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "k_neg_inv3600",
      "type": "Value",
      "params": {
        "value": -0.00027777778
      },
      "ports": {
        "o": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "discharge_pos",
      "type": "Max",
      "params": {},
      "ports": {
        "A": { "direction": "In",  "type": "Any" },
        "B": { "direction": "In",  "type": "Any" },
        "o": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "rate",
      "type": "Multiply",
      "params": {},
      "ports": {
        "A": { "direction": "In",  "type": "Any" },
        "B": { "direction": "In",  "type": "Any" },
        "o": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "accum",
      "type": "Accumulator",
      "params": {
        "initial_val": 28.0
      },
      "ports": {
        "in":  { "direction": "In",  "type": "Any" },
        "out": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "clamp_charge",
      "type": "Clamp",
      "params": {
        "min": 0.0,
        "max": 28.0
      },
      "ports": {
        "in":  { "direction": "In",  "type": "Any" },
        "out": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "norm_soc",
      "type": "Normalize",
      "params": {
        "min": 0.0,
        "max": 28.0
      },
      "ports": {
        "in":  { "direction": "In",  "type": "Any" },
        "out": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "v_in",
      "type": "BlueprintInput",
      "ports": {
        "ext":  { "direction": "In",  "type": "Any" },
        "port": { "direction": "Out", "type": "Any" }
      }
    },
    {
      "id": "v_out",
      "type": "BlueprintOutput",
      "ports": {
        "ext":  { "direction": "Out", "type": "Any" },
        "port": { "direction": "In",  "type": "Any" }
      }
    },
    {
      "id": "charge_out",
      "type": "BlueprintOutput",
      "ports": {
        "ext":  { "direction": "Out", "type": "Any" },
        "port": { "direction": "In",  "type": "Any" }
      }
    },
    {
      "id": "soc_out",
      "type": "BlueprintOutput",
      "ports": {
        "ext":  { "direction": "Out", "type": "Any" },
        "port": { "direction": "In",  "type": "Any" }
      }
    }
  ],
  "wires": [
    { "id": "w_vin_src",       "source": "/v_in:port",          "target": "/src:v_in" },
    { "id": "w_src_csense",    "source": "/src:v_out",          "target": "/csense:v_in" },
    { "id": "w_csense_vout",   "source": "/csense:v_out",       "target": "/v_out:port" },

    { "id": "w_i_max_a",       "source": "/csense:i_out",       "target": "/discharge_pos:A" },
    { "id": "w_zero_max_b",    "source": "/zero:o",             "target": "/discharge_pos:B" },
    { "id": "w_max_mul_a",     "source": "/discharge_pos:o",    "target": "/rate:A" },
    { "id": "w_k_mul_b",       "source": "/k_neg_inv3600:o",    "target": "/rate:B" },
    { "id": "w_mul_accum",     "source": "/rate:o",             "target": "/accum:in" },
    { "id": "w_accum_clamp",   "source": "/accum:out",          "target": "/clamp_charge:in" },
    { "id": "w_clamp_charge",  "source": "/clamp_charge:out",   "target": "/charge_out:port" },
    { "id": "w_clamp_norm",    "source": "/clamp_charge:out",   "target": "/norm_soc:in" },
    { "id": "w_norm_soc",      "source": "/norm_soc:out",       "target": "/soc_out:port" }
  ],
  "nested": [],
  "cpp_class": false,
  "description": "12-SAM-28 lead-acid battery (12 cells, 25.2V OCV, 28Ah capacity, 0.05 ohm internal resistance). Self-contained composite — no external configuration needed.",
  "domains": [
    "Electrical",
    "Logical"
  ],
  "priority": "high",
  "critical": true
}
