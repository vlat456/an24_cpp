{
  "version": "3.0",
  "id": "Battery",
  "display_name": "Battery",
  "interface": [
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
