{
  "version": "3.0",
  "id": "FuelTank",
  "display_name": "FuelTank",
  "scheduler_role": "None",
  "interface": [
    {
      "name": "flow_out",
      "domain": 8,
      "direction": 1,
      "type": "Pressure",
      "source_writer": true
    },
    {
      "name": "p_ref",
      "domain": 8,
      "direction": 1,
      "type": "Pressure",
      "source_writer": false
    },
    {
      "name": "level_out",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": false
    },
    {
      "name": "p_source",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Aircraft fuel reservoir with gravity head pressure (solver-owned)",
  "domains": [
    "Hydraulic"
  ],
  "param_defaults": {
    "capacity": "1000.0",
    "density": "0.78",
    "level": "1000.0",
    "consumption_rate": "0.0",
    "internal_r": "0.1",
    "tank_height": "1.0"
  },
  "param_schema": {
    "capacity": {
      "type": "float"
    },
    "density": {
      "type": "float"
    },
    "level": {
      "type": "float"
    },
    "consumption_rate": {
      "type": "float"
    },
    "internal_r": {
      "type": "float"
    },
    "tank_height": {
      "type": "float"
    }
  },
  "solver_role": {
    "kind": "PressureSource",
    "domain": "Hydraulic",
    "ports": {
      "pos": "flow_out",
      "neg": "p_ref"
    },
    "params": {
      "resistance": "internal_r"
    },
    "values": {
      "pressure": 0.0,
      "bind_handle": 1.0
    },
    "patch_op": {
      "kind": "CopySignal",
      "signal_ports": ["p_source"]
    }
  }
}
