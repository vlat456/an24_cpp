{
  "version": "3.0",
  "id": "Slider",
  "display_name": "Slider",
  "interface": [
    {
      "name": "control",
      "domain": 1,
      "direction": 0,
      "type": "Any"
    },
    {
      "name": "out",
      "domain": 1,
      "direction": 1,
      "type": "Any"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Interactive slider control with configurable min/max range. Drag the handle to set the output value.",
