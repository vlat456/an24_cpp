{
  "version": "3.0",
  "id": "Resistor",
  "display_name": "Resistor",
  "scheduler_role": "None",
  "interface": [
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Pure conductance element (resistor). Models resistive load with conductance parameter (Siemens = 1/Ohm).",
  "domains": [
    "Electrical"
  ],
  "param_defaults": {
    "conductance": "0.1"
  },
  "param_schema": {
    "conductance": {
      "type": "float"
    }
  },
  "solver_role": {
    "kind": "ConductanceBranch",
    "ports": {
      "a": "v_in",
      "b": "v_out"
    },
    "params": {
      "g": "conductance"
    }
  }
}
