{
  "version": "3.0",
  "id": "Generator",
  "display_name": "Generator",
  "scheduler_source": true,
  "solver_owned_electrical": true,
  "interface": [
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": true
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Voltage generator source with internal resistance. Similar to Battery but typically driven by mechanical power (engine/APU).",
  "domains": [
    "Electrical"
  ],
  "param_defaults": {
    "internal_r": "0.005",
    "v_nominal": "28.5"
  },
  "solver_role": {
    "kind": "TheveninSource",
    "ports": {
      "pos": "v_out",
      "neg": "v_in"
    },
    "params": {
      "voltage": "v_nominal",
      "resistance": "internal_r"
    },
    "values": {
      "bind_handle": 1.0
    }
  },
  "priority": "high",
  "content_type": "Gauge"
}
