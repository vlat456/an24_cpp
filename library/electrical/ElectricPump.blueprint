{
  "version": "3.0",
  "id": "ElectricPump",
  "display_name": "ElectricPump",
  "interface": [
    {
      "name": "p_in",
      "domain": 8,
      "direction": 0,
      "type": "Pressure"
    },
    {
      "name": "p_out",
      "domain": 8,
      "direction": 1,
      "type": "Pressure"
    },
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Electric motor driving hydraulic pump",
  "domains": [
    "Electrical",
    "Hydraulic"
  ],
  "param_defaults": {
    "max_pressure": "1000.0"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": false,
    "logical": false,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": true,
    "thermal": false
  }
}
