{
  "version": "3.0",
  "id": "Relay",
  "display_name": "Relay",
  "interface": [
    {
      "name": "control",
      "domain": 2,
      "direction": 0,
      "type": "Bool"
    },
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Electrical relay (on/off switch). When closed, connects v_in to v_out. Uses post_step voltage merging for realistic behavior.",
  "domains": [
    "Electrical",
    "Logical"
  ],
  "param_defaults": {
    "closed": "false"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": false,
    "logical": false,
    "control_commit": true,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
