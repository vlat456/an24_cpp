{
  "version": "3.0",
  "id": "HoldButton",
  "display_name": "HoldButton",
  "interface": [
    {
      "name": "control",
      "domain": 16,
      "direction": 0,
      "type": "Temperature"
    },
    {
      "name": "state",
      "domain": 2,
      "direction": 1,
      "type": "Bool"
    },
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Hold-to-operate button with press/release detection. When pressed, passes through voltage from v_in to v_out (like Switch). State output: 1.0V = pressed, 0.0V = released/idle.",
  "domains": [
    "Electrical",
    "Logical"
  ],
  "content_type": "HoldButton",
  "param_defaults": {
    "idle": "0.0"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": false,
    "logical": false,
    "control_commit": true,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
