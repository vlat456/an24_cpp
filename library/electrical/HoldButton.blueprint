{
  "version": "3.0",
  "id": "HoldButton",
  "display_name": "HoldButton",
  "scheduler_source": false,
  "solver_owned_electrical": true,
  "interface": [
    {
      "name": "control",
      "domain": 16,
      "direction": 0,
      "type": "Temperature",
      "source_writer": false
    },
    {
      "name": "state",
      "domain": 2,
      "direction": 1,
      "type": "Bool",
      "source_writer": false
    },
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Hold-to-operate button with press/release detection. When pressed, passes through voltage from v_in to v_out (like Switch). State output: 1.0V = pressed, 0.0V = released/idle.",
  "domains": [
    "Electrical",
    "Logical"
  ],
  "param_defaults": {
    "idle": "0.0",
    "g_open": "1e-6",
    "g_closed": "1000.0"
  },
  "param_schema": {
    "idle": {
      "type": "float"
    },
    "g_open": {
      "type": "float"
    },
    "g_closed": {
      "type": "float"
    }
  },
  "solver_role": {
    "kind": "ConductanceBranch",
    "ports": {
      "a": "v_in",
      "b": "v_out"
    },
    "params": {
      "g": "g_open"
    },
    "values": {
      "bind_handle": 1.0
    }
  },
  "content_type": "HoldButton"
}
