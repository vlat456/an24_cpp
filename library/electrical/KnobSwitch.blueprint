{
  "version": "3.0",
  "id": "KnobSwitch",
  "display_name": "Knob Switch",
  "scheduler_source": false,
  "solver_owned_electrical": true,
  "interface": [
    {
      "name": "wiper",
      "domain": 1,
      "direction": 2,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "throw1",
      "domain": 1,
      "direction": 2,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "throw2",
      "domain": 1,
      "direction": 2,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "throw3",
      "domain": 1,
      "direction": 2,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "throw4",
      "domain": 1,
      "direction": 2,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "throw5",
      "domain": 1,
      "direction": 2,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "control",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    },
    {
      "name": "position",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Multi-position passive rotary selector (2-5 positions). Connects wiper to selected throw (throw1..throwN) via dynamic conductance. Electrical terminals are passive/bidirectional: both wiper->throwN and throwN->wiper usage are valid. Position controlled by 'control' input (0-based). Set 'positions' param to 2-5.",
  "domains": [
    "Electrical",
    "Logical"
  ],
  "param_defaults": {
    "positions": "2",
    "initial_position": "0",
    "g_open": "1e-6",
    "g_closed": "1000.0"
  },
  "param_schema": {
    "positions": {
      "type": "int"
    },
    "initial_position": {
      "type": "int",
      "field": "selected"
    },
    "g_open": {
      "type": "float"
    },
    "g_closed": {
      "type": "float"
    }
  },
  "solver_role": {
    "kind": "KnobSwitchBranches",
    "ports": {
      "wiper": "wiper",
      "throw1": "throw1",
      "throw2": "throw2",
      "throw3": "throw3",
      "throw4": "throw4",
      "throw5": "throw5"
    },
    "params": {
      "positions": "positions",
      "initial_position": "initial_position",
      "g_open": "g_open",
      "g_closed": "g_closed"
    },
    "values": {
      "bind_handle": 1.0
    }
  },
  "content_type": "Knob"
}
