{
  "version": "3.0",
  "id": "CurrentSense",
  "display_name": "CurrentSense",
  "interface": [
    {
      "name": "i_out",
      "domain": 1,
      "direction": 1,
      "type": "I"
    },
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Series current measurement node (ammeter). Near-zero resistance passthrough that outputs measured current in amperes.",
  "domains": [
    "Electrical"
  ],
  "content_type": "Text",
  "param_defaults": {
    "conductance": "0.05"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": true,
    "logical": false,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
