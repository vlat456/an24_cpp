{
  "version": "3.0",
  "id": "Switch",
  "display_name": "Switch",
  "interface": [
    {
      "name": "control",
      "domain": 16,
      "direction": 0,
      "type": "Temperature"
    },
    {
      "name": "state",
      "domain": 2,
      "direction": 1,
      "type": "Bool"
    },
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Manual switch (toggle button). Toggles state on rising edge of control signal. Used for user-controlled switches in editor.",
  "domains": [
    "Electrical"
  ],
  "content_type": "Switch",
  "param_defaults": {
    "closed": "false"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": false,
    "logical": false,
    "control_commit": true,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
