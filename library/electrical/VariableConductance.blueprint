{
  "version": "3.0",
  "id": "VariableConductance",
  "display_name": "VariableConductance",
  "scheduler_source": false,
  "interface": [
    {
      "name": "v_in",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "v_out",
      "domain": 1,
      "direction": 1,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "cmd",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    }
