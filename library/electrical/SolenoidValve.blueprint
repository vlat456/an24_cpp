{
  "version": "3.0",
  "id": "SolenoidValve",
  "display_name": "SolenoidValve",
  "scheduler_role": "None",
  "interface": [
    {
      "name": "ctrl",
      "domain": 1,
      "direction": 0,
      "type": "V",
      "source_writer": false
    },
    {
      "name": "flow_in",
      "domain": 8,
      "direction": 0,
      "type": "Pressure",
      "source_writer": false
    },
    {
      "name": "flow_out",
      "domain": 8,
      "direction": 1,
      "type": "Pressure",
      "source_writer": false
    },
    {
      "name": "state",
      "domain": 2,
      "direction": 1,
      "type": "Bool",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Electrically controlled hydraulic valve (solver-owned)",
  "domains": [
    "Hydraulic"
  ],
  "param_defaults": {
    "normally_closed": "true",
    "g_open": "10.0",
    "g_closed": "0.0001"
  },
  "param_schema": {
    "normally_closed": {
      "type": "bool"
    },
    "g_open": {
      "type": "float"
    },
    "g_closed": {
      "type": "float"
    }
  },
  "solver_role": {
    "kind": "FlowBranch",
    "domain": "Hydraulic",
    "ports": {
      "a": "flow_in",
      "b": "flow_out"
    },
    "params": {
      "g": "g_closed"
    },
    "values": {
      "bind_handle": 1.0
    }
  }
}
