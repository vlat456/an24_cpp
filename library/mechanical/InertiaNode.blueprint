{
  "version": "3.0",
  "id": "InertiaNode",
  "display_name": "InertiaNode",
  "interface": [
    {
      "name": "input",
      "domain": 1,
      "direction": 0,
      "type": "I"
    },
    {
      "name": "output",
      "domain": 16,
      "direction": 1,
      "type": "Temperature"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Mechanical inertia simulation node",
  "domains": [
    "Mechanical"
  ],
  "param_defaults": {
    "damping": "0.5",
    "mass": "1.0"
  },
  "execution": {
    "electrical_passive": false,
    "electrical_observer": false,
    "logical": false,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": true,
    "hydraulic": false,
    "thermal": false
  }
}
