{
  "version": "3.0",
  "id": "LUT",
  "display_name": "LUT",
  "interface": [
    {
      "name": "input",
      "domain": 1,
      "direction": 0,
      "type": "Any"
    },
    {
      "name": "output",
      "domain": 1,
      "direction": 1,
      "type": "Any"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Lookup table with linear interpolation. Maps input signal to output via breakpoint table. Table is defined as semicolon-separated key:value pairs in the 'table' param.",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "table": "0:0; 100:100"
  },
  "execution": {
    "electrical_passive": false,
    "electrical_observer": false,
    "logical": true,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
