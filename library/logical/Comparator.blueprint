{
  "version": "3.0",
  "id": "Comparator",
  "display_name": "Comparator",
  "interface": [
    {
      "name": "Va",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "Vb",
      "domain": 1,
      "direction": 0,
      "type": "V"
    },
    {
      "name": "o",
      "domain": 2,
      "direction": 1,
      "type": "Bool"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Voltage comparator with hysteresis. Compares Va to Vb with configurable turn-on (Von) and turn-off (Voff) thresholds. Output is boolean (TRUE/FALSE). Thresholds are set via component parameters, not input ports.",
  "domains": [
    "Electrical",
    "Logical"
  ],
  "param_defaults": {
    "Voff": "2.0",
    "Von": "5.0"
  },
  "param_schema": {
    "Voff": {
      "type": "float"
    },
    "Von": {
      "type": "float"
    }
  },
  "execution": {
    "electrical_passive": false,
    "electrical_observer": false,
    "logical": true,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
