{
  "version": "3.0",
  "id": "SimVarInput",
  "display_name": "SimVar Input",
  "scheduler_role": "Source",
  "interface": [
    {
      "name": "out",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": true
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Reads an MSFS 2024 simulation variable and outputs it as a signal. Supports all MSFS 2024 Vars API categories: AVar (aircraft), LVar (local/shared), HEvent (cockpit events), BVar (input events), EVar (environment), IVar (instrument), OVar (component), ZVar (SimObject). Variable resolution happens at init time (pre_load), not per-frame. In JIT/Editor mode the backend is inactive (outputs default_value). In WASM/AOT mode uses direct Vars API.",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "var_name": "",
    "var_type": "AVar",
    "unit": "number",
    "index": "0",
    "default_value": "0.0"
  },
  "param_schema": {
    "var_name": {
      "type": "string"
    },
    "var_type": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "index": {
      "type": "int"
    },
    "default_value": {
      "type": "float"
    }
  }
}
