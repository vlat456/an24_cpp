{
  "version": "3.0",
  "id": "BlueprintOutput",
  "display_name": "BlueprintOutput",
  "interface": [
    {
      "name": "ext",
      "domain": 1,
      "direction": 1,
      "type": "Any"
    },
    {
      "name": "port",
      "domain": 1,
      "direction": 0,
      "type": "Any"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Output port marker for nested blueprints - exposes internal signal to parent blueprint as output port. Works as pass-through junction (union-find collapses port to connected signal).",
  "domains": [
    "Electrical",
    "Logical",
    "Mechanical",
    "Hydraulic",
    "Thermal"
  ],
  "priority": "high",
  "param_defaults": {
    "exposed_direction": "Out",
    "exposed_type": "V"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": false,
    "logical": true,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": true,
    "hydraulic": true,
    "thermal": true
  }
}
