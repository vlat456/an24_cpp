{
  "version": "3.0",
  "id": "BlueprintOutput",
  "display_name": "BlueprintOutput",
  "scheduler_source": false,

  "solver_owned_electrical": false,
  "interface": [
    {
      "name": "ext",
      "domain": 1,
      "direction": 1,
      "type": "Any",
      "source_writer": false
    },
    {
      "name": "port",
      "domain": 1,
      "direction": 0,
      "type": "Any",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": false,
  "description": "Output port marker for nested blueprints - exposes internal signal to parent blueprint as output port. Works as pass-through junction (union-find collapses port to connected signal).",
  "domains": [
    "Electrical",
    "Logical",
    "Mechanical",
    "Hydraulic",
    "Thermal"
  ],
  "param_defaults": {
    "exposed_direction": "Out",
    "exposed_type": "V"
  },
  "priority": "high"
}
