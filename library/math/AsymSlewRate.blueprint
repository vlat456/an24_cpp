{
  "version": "3.0",
  "id": "AsymSlewRate",
  "display_name": "AsymSlewRate",
  "scheduler_role": "Consumer",
  "interface": [
    {
      "name": "in",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    },
    {
      "name": "out",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Asymmetric linear rate limiter for WASM",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "deadzone": "0.0001",
    "rate_down": "0.5",
    "rate_up": "1.0"
  },
  "param_schema": {
    "deadzone": {"type": "float"},
    "rate_down": {"type": "float"},
    "rate_up": {"type": "float"}
  }
}
