{
  "version": "3.0",
  "id": "AsymTMO",
  "display_name": "AsymTMO",
  "scheduler_role": "Consumer",
  "interface": [
    {
      "name": "in",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    },
    {
      "name": "out",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Asymmetric branchless TMO for WASM",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "deadzone": "0.001",
    "tau_down": "0.5",
    "tau_up": "0.1"
  },
  "param_schema": {
    "deadzone": {"type": "float"},
    "tau_down": {"type": "float"},
    "tau_up": {"type": "float"}
  }
}
