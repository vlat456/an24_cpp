{
  "version": "3.0",
  "id": "Monostable",
  "display_name": "Monostable",
  "interface": [
    {
      "name": "in",
      "domain": 2,
      "direction": 0,
      "type": "Bool"
    },
    {
      "name": "out",
      "domain": 2,
      "direction": 1,
      "type": "Bool"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Pulse timer: outputs 1.0 for duration after rising edge",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "duration": "30.0"
  },
  "execution": {
    "electrical_passive": false,
    "electrical_observer": false,
    "logical": true,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": false,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
