{
  "version": "3.0",
  "id": "LerpNode",
  "display_name": "LerpNode",
  "interface": [
    {
      "name": "input",
      "domain": 1,
      "direction": 0,
      "type": "Any"
    },
    {
      "name": "output",
      "domain": 1,
      "direction": 1,
      "type": "Any"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Linear interpolation node (first-order filter) for sensor simulation with deadzone",
  "domains": [
    "Electrical"
  ],
  "param_defaults": {
    "deadzone": "0.001",
    "factor": "0.05"
  },
  "execution": {
    "electrical_passive": true,
    "electrical_observer": false,
    "logical": false,
    "control_commit": false,
    "electrical_actuator": false,
    "finalize": true,
    "mechanical": false,
    "hydraulic": false,
    "thermal": false
  }
}
