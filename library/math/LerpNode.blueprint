{
  "version": "3.0",
  "id": "LerpNode",
  "display_name": "LerpNode",
  "scheduler_source": false,

  "solver_owned_electrical": false,
  "interface": [
    {
      "name": "input",
      "domain": 2,
      "direction": 0,
      "type": "Signal",
      "source_writer": false
    },
    {
      "name": "output",
      "domain": 2,
      "direction": 1,
      "type": "Signal",
      "source_writer": false
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Linear interpolation node (first-order filter) for sensor simulation with deadzone",
  "domains": [
    "Electrical"
  ],
  "param_defaults": {
    "deadzone": "0.001",
    "factor": "0.05"
  },
  "param_schema": {
    "deadzone": {"type": "float"},
    "factor": {"type": "float"}
  }
}
