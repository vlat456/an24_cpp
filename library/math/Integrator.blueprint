{
  "version": "3.0",
  "id": "Integrator",
  "display_name": "Integrator",
  "interface": [
    {
      "name": "in",
      "domain": 1,
      "direction": 0,
      "type": "Any"
    },
    {
      "name": "out",
      "domain": 1,
      "direction": 1,
      "type": "Any"
    },
    {
      "name": "reset",
      "domain": 2,
      "direction": 0,
      "type": "Bool"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Mathematical integrator with reset: out = integral(in * dt)",
  "domains": [
    "Logical"
  ],
  "param_defaults": {
    "gain": "1.0",
    "initial_val": "0.0"
  }
}
