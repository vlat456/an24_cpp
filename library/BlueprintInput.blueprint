{
  "version": "3.0",
  "id": "BlueprintInput",
  "display_name": "BlueprintInput",
  "interface": [
    {
      "name": "ext",
      "domain": 1,
      "direction": 0,
      "type": "Any"
    },
    {
      "name": "port",
      "domain": 1,
      "direction": 1,
      "type": "Any"
    }
  ],
  "nodes": [],
  "wires": [],
  "nested": [],
  "cpp_class": true,
  "description": "Input port marker for nested blueprints - exposes internal signal to parent blueprint as input port. Works as pass-through junction (union-find collapses port to connected signal).",
  "domains": [
    "Electrical",
    "Logical",
    "Mechanical",
    "Hydraulic",
    "Thermal"
  ],
  "priority": "high",
  "param_defaults": {}
}
