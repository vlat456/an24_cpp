{
    "devices": [
        {"name": "gnd", "classname": "RefNode", "params": {"value": "0.0"}},
        {"name": "k_voltage", "classname": "Value", "params": {"value": "28.5"}},
        {"name": "k_one", "classname": "Value", "params": {"value": "1.0"}},
        {"name": "k_zero", "classname": "Value", "params": {"value": "0.0"}},
        {"name": "k_zero_2", "classname": "Value", "params": {"value": "0.0"}},
        {"name": "k_max", "classname": "Value", "params": {"value": "30.0"}},
        {"name": "src", "classname": "ControlledVoltageSource", "params": {"r_internal": "0.01"}},
        {"name": "load", "classname": "Resistor", "params": {"conductance": "0.1"}}
    ],
    "connections": [
        {"from": "k_voltage.o", "to": "src.cmd"},
        {"from": "k_one.o", "to": "src.gain"},
        {"from": "k_zero.o", "to": "src.offset"},
        {"from": "k_zero_2.o", "to": "src.min_v"},
        {"from": "k_max.o", "to": "src.max_v"},
        {"from": "gnd.v", "to": "src.v_neg"},
        {"from": "src.v_pos", "to": "load.v_in"},
        {"from": "load.v_out", "to": "gnd.v"}
    ],
    "templates": {}
}
